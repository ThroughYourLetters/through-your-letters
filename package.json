{
  "name": "through-the-letters",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "type-check": "turbo run type-check",
    "check:toolchains": "node scripts/check-toolchains.mjs",
    "check:dependencies": "knip --include dependencies,unlisted && pnpm --filter @ttl/mobile check:dependencies && node scripts/audit-node-dependencies.mjs",
    "db:up": "docker-compose up -d postgres redis",
    "db:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "knip": "6.43.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.28.8 <12"
  }
}
