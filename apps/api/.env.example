# Required
DATABASE_URL=postgresql://dev:dev@localhost:5432/through-your-letters
REDIS_URL=redis://localhost:6379
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_FORCE_PATH_STYLE=false
R2_BUCKET_NAME=through-your-letters
R2_PUBLIC_URL=https://<public_r2_domain>
JWT_SECRET=replace_with_long_random_secret
ADMIN_JWT_SECRET=replace_with_a_different_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2b$12$replace_with_bcrypt_hash'
CITY_DISCOVERY_USER_AGENT=through-your-letters/1.0 (admin@example.com)

# Optional
ALLOWED_ORIGINS=http://localhost:5173
# Render web services detect managed ingress automatically; no proxy CIDRs needed.
# For other deployments, empty trusts only TCP peers. Add only verified proxy CIDRs.
# TRUSTED_PROXY_CIDRS=10.0.0.5/32,2001:db8::5/128
TRUSTED_PROXY_CIDRS=
APP_BASE_URL=http://localhost:5173
# RESEND_API_KEY=replace_with_email_provider_key
# EMAIL_FROM=noreply@your_verified_domain
DATABASE_MAX_CONNECTIONS=20
HOST=0.0.0.0
PORT=3000
HUGGINGFACE_TOKEN=
ENABLE_ML_PROCESSING=true
ML_MODEL_PATH=./models/text_detector.onnx
ENABLE_VIRUS_SCAN=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
RATE_LIMIT_UPLOADS_PER_IP=100
ENABLE_PENDING_AUTO_APPROVE=true
PENDING_AUTO_APPROVE_MINUTES=30
PENDING_AUTO_APPROVE_INTERVAL_SECONDS=300
PENDING_AUTO_APPROVE_BATCH_SIZE=50
# Recovery override only; ordinary startup must validate all applied history.
IGNORE_MISSING_MIGRATIONS=false
RUST_LOG=info

# Run analysis workers on the intended instances; PostgreSQL coordinates claims.
# Ignored when ML processing is disabled.
ENABLE_ML_WORKER=true

# Optional replacement for the bundled operational limits (no secrets).
# TTL_LIMITS_FILE=/app/config/runtime.json
# Full overrides must include the current passwords and images sections.
